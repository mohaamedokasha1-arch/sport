# ─── NEMO Sports · environment ───────────────────────────────────────────────
# Copy to `.env.local` (never commit it). Every variable is OPTIONAL: the
# platform boots without any of them and degrades instead of failing.
# What each one unlocks is noted inline.

# ── production origin (SEO)
# The single source of truth for canonical URLs, Open Graph, JSON-LD,
# sitemap.xml and robots.txt (lib/site.ts). Falls back, in order, to
# VERCEL_PROJECT_PRODUCTION_URL (set automatically by Vercel), then
# VERCEL_URL, then https://nemo-sports.vercel.app. Set this explicitly once a
# custom domain is actually attached and serving traffic — never point it at
# a domain the project does not control (that caused the Search Console
# "URL غير مسموح به" error).
NEXT_PUBLIC_SITE_URL=

# ── demo content switch
# The offline demo dataset (fixtures, live scores, news, standings) is available
# in development when no data provider is configured. If you explicitly force
# demo mode with NEMO_SDL_MODE=demo, set this public flag to 1 as well so the
# server and browser agree during hydration. In production, set to 1 ONLY on a
# demo deployment; demo content remains non-indexable and is never real data.
NEXT_PUBLIC_DEMO_CONTENT=

# ── provider credentials (SDL only — never reachable from frontend or backend)
# Add one and the priority chain for that provider activates on the next boot;
# the mode flips from "demo" to "live" as soon as at least one is present,
# which also makes the site indexable again.
# Aliases: SPORTMONKS_API_TOKEN is accepted in place of SPORTMONKS_TOKEN, and
# THESPORTSDB_API_KEY in place of THESPORTSDB_KEY — set either spelling, not
# both (the original name wins if both are present).
SPORTRADAR_KEY=
SPORTMONKS_TOKEN=
API_FOOTBALL_KEY=
THESPORTSDB_KEY=

# ── SportScore (keyless, multi-sport — the default live-data source)
# SportScore's widget API needs NO key, so it is registered and enabled by
# default. That has a consequence worth stating explicitly: because it counts
# as a real source, its mere presence is what flips the platform from "demo" to
# "live". Indexability no longer follows from that alone (lib/sdl-gateway.ts
# probes whether data can actually be served), but this variable still decides
# whether the provider is registered at all.
#   0 = do not register SportScore
NEMO_SPORTSCORE_ENABLED=
# Base URL override for approved transports or isolated local tests. Default is
# the direct provider endpoint, including on Vercel. Access-control failures
# are surfaced honestly; do not bypass upstream restrictions. Verify permission
# and provider terms before enabling the legacy relay.
SPORTSCORE_BASE_URL=
# Compatibility relay is OFF by default. Enable only with provider permission.
NEMO_SPORTSCORE_RELAY_ENABLED=

# ── Football-Data.org (free tier: 12 competitions, 10 calls/minute)
# Get a key at https://www.football-data.org/client/register and paste it here.
# SERVER-SIDE ONLY: never prefix it with NEXT_PUBLIC_, never expose it through an
# API route and never read it in a component. It is read in
# packages/sdl/src/index.ts (getSdl) and travels only in the provider request
# header (X-Auth-Token). When set, this provider leads the football standings /
# scorers / fixtures chains; when it fails the site shows
# "Data temporarily unavailable" instead of any placeholder data.
FOOTBALL_DATA_API_KEY=
# Internal request budget per minute. Default 8 (headroom under the free plan's
# published 10/min). Paid plans: raise it to the plan's limit (e.g. 55).
FOOTBALL_DATA_REQUESTS_PER_MINUTE=
# Competitions monitored by unscoped list calls (default: the majors).
# FOOTBALL_DATA_COMPETITIONS=PL,PD,SA,BL1,FL1,CL,DED,PPL,ELC,BSA,WC,EC
FOOTBALL_DATA_COMPETITIONS=
# Optional season override, as the starting year (e.g. 2025). Default: current.
FOOTBALL_DATA_SEASON=
# Base URL override. Leave empty in every real environment: the adapter targets
# https://api.football-data.org/v4. It exists so the integration can be developed
# offline against `node scripts/mock-football-data.mjs` (never point it at a host
# you do not control).
FOOTBALL_DATA_BASE_URL=

# ── durable canonical store (Postgres)
# Without it the canonical store is in-process: entities are re-resolved on
# every boot and nothing is persisted. Apply the schema first:
#   npm run db:setup        (psql $DATABASE_URL -f db/schema.sql -f db/seed.sql)
DATABASE_URL=
PG_POOL_MAX=5

# ── distributed cache (Redis)
# Without it the five cache layers live in the process. Required for more than
# one replica, otherwise each replica keeps its own rate-limit budget.
REDIS_URL=
REDIS_KEY_PREFIX=

# ── ingestion (cron entry point: POST /api/v1/ingest, or `npm run ingest`)
# Unset ⇒ the route returns 503 and refuses to spend provider quota.
NEMO_INGEST_TOKEN=
# Alternative secret for the same route. Vercel Cron automatically sends
# `Authorization: Bearer $CRON_SECRET` on every scheduled hit, and cron paths in
# vercel.json are NOT env-interpolated — so the secret must ride the header.
# Set this (or NEMO_INGEST_TOKEN) for the daily cron in vercel.json to run;
# with neither set the cron hits the route and is refused.
CRON_SECRET=

# ── admin access (middleware.ts)
# Guards /admin*, /api/v1/system and /api/admin/*. The panel is fail-closed:
# without one of the configurations below it returns 404/503 instead of being
# public.
#
# Preferred operator login (the password is NEVER stored in plaintext):
ADMIN_USERNAME=admin
# Generate with: npm run admin:hash -- '<long password>'
ADMIN_PASSWORD_HASH=
# Optional independent signing key. Rotating it invalidates every session.
# If unset, the configured token/hash is used as the signing key.
ADMIN_SESSION_SECRET=
# Optional break-glass Basic Auth password for existing deployments. Use a
# long random value (openssl rand -hex 32); it is compared server-side only.
ADMIN_ACCESS_TOKEN=

# ── behaviour
# auto  = use provider keys when present, otherwise the offline demo adapter
# demo  = force the demo adapter even when keys exist (dev / CI)
NEMO_SDL_MODE=auto
# 1 = log every cache operation (redis get/set/del/scan)
NEMO_DEBUG=0

# ── live stream / broadcast link policy (lib/stream-policy.ts)
# Decides which embed URLs the admin panel accepts at /admin/live and
# /admin/broadcast.
#   open      = DEFAULT. Any https link an authorized admin enters is accepted
#               and can be saved/published — no domain restriction. Unlisted
#               hosts only produce a non-blocking note reminding the operator
#               that embed rights are their responsibility.
#   allowlist = curated mode: only the reference domains in lib/broadcasts.ts
#               (OFFICIAL_BROADCAST_DOMAINS) plus NEMO_STREAM_ALLOWED_DOMAINS
#               are accepted; anything else is refused.
# Leave empty to use `open`. Aliases: STREAM_DOMAIN_POLICY, or
# NEMO_STRICT_STREAM_DOMAINS=1 to force `allowlist`.
NEMO_STREAM_DOMAIN_POLICY=
# Extra domains accepted in `allowlist` mode (comma or space separated; a
# subdomain of an entry is accepted too). Ignored in `open` mode except to
# suppress the "unlisted host" note.
NEMO_STREAM_ALLOWED_DOMAINS=
# NOTE — always enforced in BOTH modes and not configurable: https only, no
# HTML/script markup or quotes in the value, no javascript:/data:/blob: scheme,
# no embedded credentials, no non-standard port, no loopback/private/.internal
# host. Those protect visitors (XSS, dead iframes), not content rights.

# ── automatic news pipeline (Google News RSS — free, no key)
# No credentials needed: RSS feeds are public. Scheduled ingestion runs on
# Vercel Cron (daily schedule — see vercel.json), or an authorized external
# scheduler. Public reads do NOT launch background work. Durable production
# news writes require DATABASE_URL. CRON_SECRET / NEMO_INGEST_TOKEN above also
# authorize /api/cron/fetch-news. Point NEMO_NEWS_DISABLE at 1 ONLY to freeze
# all fetching (e.g. incident response) — the feed then serves cache only.
NEMO_NEWS_DISABLE=

# Legacy manual fixture bootstrap (OFF). Existing database rows/files are kept.
# Only set to 1 after editorially verifying the bundled manual records.
# This permits insertion into an EMPTY admin_matches table; it never overwrites rows.
NEMO_BOOTSTRAP_LEGACY_DATA=

# Production writes always require DATABASE_URL; ADMIN_ALLOW_MEMORY_STORE is
# no longer a production escape hatch. Local tests can use in-memory stores.
# See docs/IMPLEMENTATION_2026-10-09.md for evidence, limitations and rollout.
