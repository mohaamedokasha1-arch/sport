{
  "name": "nemo-sports",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev -H 0.0.0.0 -p 3000",
    "build": "next build",
    "start": "next start -H 0.0.0.0 -p 3000",
    "check": "npm run typecheck && npm run sdl:test && npm run repairs:test && npm run admin:test && npm run news:test && npm run search:test && node scripts/smoke.mjs",
    "sdl:typecheck": "tsc -p packages/sdl/tsconfig.json --noEmit",
    "sdl:test": "tsc -p packages/sdl/tsconfig.test.json && node --test \"packages/sdl/dist-test/test/*.test.js\"",
    "test": "npm run sdl:test",
    "ingest": "tsx scripts/ingest.ts",
    "db:setup": "node scripts/db-setup.mjs",
    "db:verify": "tsx scripts/verify-db.ts",
    "news:test": "tsx scripts/verify-news.ts",
    "search:test": "tsx scripts/verify-search.ts",
    "admin:hash": "node scripts/hash-admin-password.mjs",
    "admin:test": "tsx scripts/verify-admin.ts",
    "repairs:test": "tsx --test scripts/verify-repairs.test.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "ioredis": "^5.4.2",
    "next": "15.5.27",
    "pg": "^8.13.1",
    "react": "19.1.0",
    "react-dom": "19.1.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.1.13",
    "@types/node": "22.10.2",
    "@types/pg": "^8.11.10",
    "@types/react": "19.1.0",
    "@types/react-dom": "19.1.0",
    "tailwindcss": "4.1.13",
    "tsx": "^4.19.2",
    "typescript": "5.7.2"
  },
  "overrides": {
    "postcss": "8.5.29"
  }
}
