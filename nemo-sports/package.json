{
  "name": "nemo-sports",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "admin:hash": "node scripts/hash-admin-password.mjs",
    "admin:test": "tsx scripts/verify-admin.ts",
    "build": "next build",
    "check": "npm run typecheck && npm run sdl:test && npm run repairs:test && npm run admin:test && npm run news:test && npm run search:test && npm run freshness:test && npm run sports:test && npm run competitions:test && npm run stream-policy:test && npm run news:classify:test && npm run consistency:test && npm run scenarios:test && npm run pipeline:config:check && npm run pipeline:test",
    "competitions:report": "tsx scripts/report-competition-coverage.ts docs/competition-coverage.json",
    "competitions:test": "tsx --test scripts/verify-competition-sync.test.ts",
    "consistency:test": "tsx --tsconfig scripts/tsconfig.jsx-tests.json --test scripts/verify-consistency.test.ts",
    "db:setup": "node scripts/db-setup.mjs",
    "db:verify": "tsx scripts/verify-db.ts",
    "dev": "next dev -H 0.0.0.0 -p 3000",
    "freshness:test": "tsx --test scripts/verify-freshness.test.ts",
    "ingest": "tsx scripts/ingest.ts",
    "mock:news": "node scripts/mock-news-feeds.mjs",
    "news:classify:test": "tsx --test scripts/verify-classify.test.ts",
    "news:moderate": "tsx scripts/moderate-news.ts",
    "news:recategorize": "tsx scripts/recategorize-news.ts",
    "news:test": "tsx scripts/verify-news.ts",
    "pipeline:config:check": "tsx scripts/pipeline-config-sync.ts --check",
    "pipeline:config:sync": "tsx scripts/pipeline-config-sync.ts",
    "pipeline:doctor": "tsx scripts/pipeline.ts doctor",
    "pipeline:loop": "tsx scripts/pipeline.ts loop",
    "pipeline:prune": "tsx scripts/pipeline.ts prune",
    "pipeline:run": "tsx scripts/pipeline.ts run",
    "pipeline:status": "tsx scripts/pipeline.ts status",
    "pipeline:test": "tsx --test scripts/verify-pipeline.test.ts",
    "pipeline:tick": "tsx scripts/pipeline.ts tick",
    "repairs:test": "tsx --test scripts/verify-repairs.test.ts",
    "replay:today": "node scripts/replay-sportscore-today.mjs",
    "scenarios:test": "tsx scripts/verify-all-scenarios.ts",
    "sdl:test": "tsc -p packages/sdl/tsconfig.test.json && node --test \"packages/sdl/dist-test/test/*.test.js\"",
    "sdl:typecheck": "tsc -p packages/sdl/tsconfig.json --noEmit",
    "search:test": "tsx scripts/verify-search.ts",
    "smoke": "node scripts/smoke.mjs",
    "sports:test": "tsx --test scripts/verify-sports-links.test.ts",
    "start": "next start -H 0.0.0.0 -p 3000",
    "stream-policy:test": "tsx --test scripts/verify-stream-policy.test.ts",
    "test": "npm run sdl:test",
    "typecheck": "tsc --noEmit",
    "verify:live": "node scripts/verify-live-consistency.mjs",
    "verify:news-ingestion": "node scripts/verify-news-ingestion.mjs"
  },
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "ioredis": "^5.4.2",
    "next": "15.5.27",
    "pg": "^8.13.1",
    "react": "19.1.0",
    "react-dom": "19.1.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.1.13",
    "@types/node": "22.10.2",
    "@types/pg": "^8.11.10",
    "@types/react": "19.1.0",
    "@types/react-dom": "19.1.0",
    "tailwindcss": "4.1.13",
    "tsx": "^4.19.2",
    "typescript": "5.7.2"
  },
  "overrides": {
    "postcss": "8.5.29"
  }
}
