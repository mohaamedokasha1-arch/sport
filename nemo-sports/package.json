{
  "name": "nemo-sports",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev -H 0.0.0.0 -p 3000",
    "build": "next build",
    "start": "next start -H 0.0.0.0 -p 3000",
    "check": "npm run sdl:test && node scripts/smoke.mjs",
    "sdl:typecheck": "tsc -p packages/sdl/tsconfig.json --noEmit",
    "sdl:test": "tsc -p packages/sdl/tsconfig.test.json && node --test packages/sdl/dist-test/test/",
    "test": "npm run sdl:test",
    "ingest": "tsx scripts/ingest.ts",
    "db:setup": "psql \"$DATABASE_URL\" -f db/schema.sql && psql \"$DATABASE_URL\" -f db/seed.sql"
  },
  "dependencies": {
    "ioredis": "^5.4.2",
    "next": "15.5.25",
    "pg": "^8.13.1",
    "react": "19.1.0",
    "react-dom": "19.1.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.1.13",
    "@types/node": "22.10.2",
    "@types/pg": "^8.11.10",
    "@types/react": "19.1.0",
    "@types/react-dom": "19.1.0",
    "tailwindcss": "4.1.13",
    "tsx": "^4.19.2",
    "typescript": "5.7.2"
  }
}
