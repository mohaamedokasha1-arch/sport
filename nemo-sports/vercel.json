{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "crons": [
    {
      "path": "/api/v1/ingest",
      "schedule": "0 3 * * *"
    },
    {
      "path": "/api/cron/fetch-news",
      "schedule": "30 3 * * *"
    },
    {
      "path": "/api/cron/sync-competitions",
      "schedule": "45 3 * * 1"
    },
    {
      "path": "/api/cron/pipeline/matches",
      "schedule": "0 4 * * *"
    },
    {
      "path": "/api/cron/pipeline/standings",
      "schedule": "0 23 * * *"
    },
    {
      "path": "/api/cron/pipeline/competitions",
      "schedule": "15 4 * * 1"
    },
    {
      "path": "/api/cron/discover-fixtures",
      "schedule": "30 4 * * *"
    },
    {
      "path": "/api/cron/sports-sync/catalog",
      "schedule": "0 5 * * 1"
    },
    {
      "path": "/api/cron/sports-sync/tick",
      "schedule": "15 5 * * *"
    }
  ]
}
